# ---- 前端公开配置 ----
# 后端地址（末尾带斜杠）。AI 接口同样走这里：{apiBase}ai/chat/ 等
# NUXT_PUBLIC_API_URL=https://kotae.cn/api/
# NUXT_PUBLIC_SITE_URL=https://kotae.cn

# 站点级 AI 开关（true / false），关掉后不渲染任何 AI 入口。
# 注意：能否真正使用还取决于「是否登录」与「是否已配置自己的 API Key」，
# 每个用户在界面里的「AI 设置」中填写，密钥由 Django 后端加密保存。
# NUXT_PUBLIC_AI_ENABLED=true

# ---- 以下配置已迁移到 Django 后端（见 backend/.env）----
# AI_DEFAULT_BASE_URL / AI_DEFAULT_MODEL / AI_TEMPERATURE / AI_MAX_TOKENS
# AI_CONNECT_TIMEOUT / AI_TIMEOUT / AI_THROTTLE_RATE
# 上游 API Key 不再由站点统一配置，改由每个用户自带（每用户独立计费）。

# ---- 新文章广播（scripts/broadcast.mjs）----
# 只给本地脚本用，不参与 Nuxt 构建。三项都不配也能跑，脚本会自动跳过缺配置的平台。
# 用 node scripts/broadcast.mjs --dry-run 可以先看发出去长什么样。

# Telegram：找 @BotFather 建 bot 拿 token，把 bot 拉进频道/群后取 chat_id
# TG_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TG_CHAT_ID=-1001234567890

# Discord：频道设置 → 整合 → Webhook → 复制 URL
# 注意：真实 URL 只写在 .env 里，本文件会提交到仓库，别填真实凭证
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/<id>/<token>

# X（可选）：开发者后台创建 App，权限选 Read and Write，生成 Access Token
# 免费层是 write-only，500 条/月，足够博客同步
# X_API_KEY=
# X_API_SECRET=
# X_ACCESS_TOKEN=
# X_ACCESS_SECRET=

# 覆盖订阅源地址与「多久算旧文章」（默认线上 RSS，72 小时）
# BROADCAST_FEED_URL=https://kotae.cn/rss.xml
# BROADCAST_MAX_AGE_HOURS=72

# 代理：Discord / Telegram / X 都在墙外，国内直连会超时。
# 开了代理软件就填这里（Clash 默认 7890），要填 **HTTP 代理**端口，不是 SOCKS。
# 不填则直连，脚本会在报错里提示连接超时。
# BROADCAST_PROXY=http://127.0.0.1:7890
