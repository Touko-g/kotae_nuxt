# ---- Qwen（阿里云百炼 DashScope）----
# 控制台：https://bailian.console.aliyun.com/ -> API-KEY 管理
# 只在服务端使用，不会进入客户端 bundle；前端统一走 /api/ai/* 代理
NUXT_AI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# OpenAI 兼容模式地址（默认北京站；新加坡站见 nuxt.config.ts 注释）
# NUXT_AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 默认模型：qwen-flash（快而便宜，免费额度充足）/ qwen-max（质量最好）/ qwen-long（长文）
# 必须是「对话」模型：rerank、embedding、tts 这类走 OpenAI 兼容模式会直接 502
# （实测 qwen3.7-text-rerank -> Unsupported model）
# qwen-plus 的免费额度用完会直接 502，需要控制台充值或关掉「仅用免费额度」
# NUXT_AI_MODEL=qwen-flash

# 生成参数
# NUXT_AI_TEMPERATURE=0.7
# NUXT_AI_MAX_TOKENS=2048
# NUXT_AI_TIMEOUT=60000

# 单 IP 限流（窗口内请求数 / 窗口毫秒），0 关闭
# NUXT_AI_RATE_LIMIT=20
# NUXT_AI_RATE_WINDOW=60000
